# ==================================================================
# Contoh konfigurasi. Salin ke .env dan isi nilainya.
# JANGAN commit file .env ke git.
# ==================================================================

# ---------- Umum ----------
PORT=3000
TZ_APP=Asia/Jakarta
ISP_NAME=Nama RT/RW Net Anda
CS_PHONE=628123456789

# Alamat halaman walled garden isolir, dicantumkan di pesan WhatsApp.
# Harus HTTP (bukan HTTPS) supaya bisa diakses dari jaringan isolir.
ISOLIR_URL=http://isolir.namaisp.net

# ---------- Database ----------
# Butuh replica set untuk transaksi. Atlas sudah otomatis.
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/billing?retryWrites=true&w=majority

# ---------- Keamanan ----------
# Generate masing-masing sekali, jangan pakai nilai yang sama:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ROUTER_SECRET_KEY=
JWT_ADMIN_SECRET=
JWT_CUSTOMER_SECRET=

JWT_ADMIN_TTL=12h
JWT_CUSTOMER_TTL=30d

# Domain yang boleh memanggil API. Untuk app Capacitor, sertakan
# https://localhost dan capacitor://localhost.
CORS_ORIGINS=https://billing.namaisp.net,https://localhost,capacitor://localhost

# ---------- Midtrans ----------
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# ---------- RouterOS ----------
RB_PROFILE_ISOLIR=isolir
RB_LIST_ISOLIR=isolir
# Router dianggap bermasalah kalau tidak terjangkau lebih dari sekian menit
ROUTER_OFFLINE_ALERT_MIN=20

# ---------- Penagihan ----------
# Invoice terbit H-7 sebelum jatuh tempo
INVOICE_LEAD_DAYS=7
# Masa tenggang sebelum diisolir
ISOLIR_GRACE_DAYS=3
# false = tanpa kode unik nominal (kalau hanya pakai QRIS/VA)
USE_UNIQUE_CODE=true

# ---------- WhatsApp (Baileys) ----------
WA_SESSION_DIR=./.wa-session
WA_BATCH_SIZE=20
WA_MAX_RETRY=3
WA_HOURLY_LIMIT=120
WA_MIN_DELAY_MS=4000
WA_MAX_DELAY_MS=12000
# Jam tenang — tidak mengirim notifikasi biasa. OTP tetap dikirim.
WA_QUIET_START=21
WA_QUIET_END=7

# ---------- Alert / watchdog ----------
# PENTING: alert TIDAK lewat WhatsApp. Yang paling sering perlu
# dilaporkan justru matinya WhatsApp itu sendiri.
#
# Cara membuat bot Telegram:
#   1. Chat @BotFather di Telegram, kirim /newbot, ikuti langkahnya
#   2. Salin token yang diberikan ke TELEGRAM_BOT_TOKEN
#   3. Chat bot barumu sekali (kirim apa saja)
#   4. Buka https://api.telegram.org/bot<TOKEN>/getUpdates
#      lalu salin nilai result[0].message.chat.id ke TELEGRAM_CHAT_ID
#   5. Restart API server, lalu tekan "Kirim pesan uji" di panel → Sistem
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alternatif atau tambahan: webhook Discord / Slack / n8n
ALERT_WEBHOOK_URL=

# Jangan kirim alert yang sama berulang dalam sekian menit
ALERT_COOLDOWN_MIN=60

# Ambang batas watchdog WhatsApp
WA_HEARTBEAT_STALE_MIN=5
WA_DISCONNECT_ALERT_MIN=10
WA_FAILURE_THRESHOLD=5
WA_BACKLOG_THRESHOLD=20
WA_BACKLOG_AGE_MIN=60

# ---------- Proses ----------
# Set false di instance yang TIDAK boleh menjalankan cron
ENABLE_CRON=true
# true kalau Express yang melayani hasil build panel admin
SERVE_ADMIN=false

# ---------- Dokumentasi API ----------
# Swagger UI di /api/docs. Biarkan false di produksi — daftar endpoint
# tidak perlu ikut dipublikasikan bersama API.
ENABLE_DOCS=false
